PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/friend.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
ALLOW_REGISTRATION=true

# Local inference is the default. Do not expose your computer's Ollama port.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# On Render, choose an OpenAI-compatible hosted provider and set its key privately.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=

ADMIN_EMAIL=
ADMIN_PASSWORD=
